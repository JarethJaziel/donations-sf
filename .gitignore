# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local IDE & Agent runner metadata
.codex/
.cursor/
.gemini/

# Local environment variables & secrets protection (M3)
.env
.env.*
*.key
*.pem
*stripe_keys*

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Metadatos del sitio que contienen datos personales (correo remitente, usuario administrador).
# Se despliegan desde la máquina local; no se publican en el repositorio (M3).
force-app/main/default/networks/
force-app/main/default/sites/

# Carpeta de trabajo de la skill impeccable (diseño); no forma parte del proyecto.
.impeccable/
